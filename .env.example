# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
# Optional: constrain replies that originate from a Minecraft chat bridge channel.
# Leave blank / 0 to disable.
SHORT_RESPONSE_CHANNEL_ID=
SHORT_RESPONSE_CHAR_LIMIT=0
# Per-user response cooldown and short conversation memory.
COOLDOWN_SECONDS=6
HISTORY_TTL_SECONDS=600
MAX_HISTORY_PAIRS=3

# ── NATS JetStream ───────────────────────────────────────────────────────────
# Overridden per-service in docker-compose.yml; only needed if running outside Docker
NATS_URL=nats://localhost:4222
NATS_BOT_USER=raphael_bot
NATS_BOT_PASSWORD=change_me_bot_nats_password
NATS_BOT_PASSWORD_BCRYPT=change_me_generated_with_scripts_generate_nats_bcrypt
NATS_WORKER_USER=raphael_worker
NATS_WORKER_PASSWORD=change_me_worker_nats_password
NATS_WORKER_PASSWORD_BCRYPT=change_me_generated_with_scripts_generate_nats_bcrypt
NATS_API_USER=raphael_api
NATS_API_PASSWORD=change_me_api_nats_password
NATS_API_PASSWORD_BCRYPT=change_me_generated_with_scripts_generate_nats_bcrypt
# Shared only by bot and worker to sign/verify NATS payload envelopes.
NATS_MESSAGE_HMAC_KEY=change_me_long_random_hmac_key

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=https://localhost:6333
QDRANT_API_KEY=change_me_strong_random_key
# Generate local TLS files with: ./scripts/generate_qdrant_tls.sh
QDRANT_TLS_CA_CERT=./certs/qdrant/ca.pem

# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: "groq", "ollama", or "openai" for LM Studio/OpenAI-compatible local servers
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# LM Studio / OpenAI-compatible local server — only needed when LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://host.docker.internal:1234
# OPENAI_MODEL=qwen/qwen3-8b
# Enable OpenAI-compatible tool calling with a built-in DuckDuckGo-backed web search tool.
OPENAI_ENABLE_WEB_SEARCH=false
OPENAI_WEB_SEARCH_MAX_RESULTS=5

# Ollama — only needed when LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2

# ── M2M API Keys ──────────────────────────────────────────────────────────────
# Format: "role:key,role:key,..."
# Roles: sync (trigger syncs), read (read stats/status), admin (all)
# Generate keys with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=sync:change_me_sync_key,read:change_me_read_key,admin:change_me_admin_key

# ── Wiki ─────────────────────────────────────────────────────────────────────
WIKI_HOST=tensura.wiki.gg

# ── Qdrant collections ───────────────────────────────────────────────────────
WIKI_COLLECTION=wiki
SUBTITLES_COLLECTION=subtitles
ADDONS_COLLECTION=addons

# ── External add-on docs ─────────────────────────────────────────────────────
# Comma-separated project/docs pages to scrape into the "addons" vector collection.
ADDON_SOURCE_URLS=https://wiki.trbeyond.com/wiki,https://modrinth.com/mod/tensura-beyond-worlds
# For each bundled Modrinth mod, crawl up to this many same-site wiki/doc pages from its wiki_url.
ADDON_MOD_WIKI_MAX_PAGES=8

# ── Embeddings ───────────────────────────────────────────────────────────────
# Provider: "local" (sentence-transformers in-process) or "api" (OpenAI-compatible endpoint)
# When EMBED_PROVIDER=api, vectors are fetched from {EMBED_BASE_URL}/v1/embeddings.
# Leave EMBED_BASE_URL empty to reuse OLLAMA_BASE_URL (e.g. LM Studio on the same host).
EMBED_PROVIDER=local
# EMBED_BASE_URL=http://host.docker.internal:1234
EMBED_MODEL=all-MiniLM-L6-v2

# ── Reranker ─────────────────────────────────────────────────────────────────
# Cross-encoder model for re-scoring retrieved wiki chunks.  Runs locally in the
# worker container (22 MB, CPU-friendly).  Set to "" to disable reranking.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5

# ── RAG tuning ───────────────────────────────────────────────────────────────
RELEVANCE_THRESHOLD=0.30
K_FACTUAL=8
K_COMPARATIVE=10
MAX_ENUM_CHARS=8000
MAX_COMPARATIVE_CHARS=16000

# ── Subtitle downloader ───────────────────────────────────────────────────────
# fetch_subtitles.py downloads via SubDL.com (free account required).
# Register at https://subdl.com and add your API key here.
SUBDL_API_KEY=
